+  /**
+   * Trim a stored key down to what proto.MessageKey actually carries.
+   *
+   * The stored key round-trips through JSON and comes back with an empty-string
+   * `participant` on every 1:1 message, plus fields the proto does not define at
+   * all (`remoteJidAlt`, `participantAlt`, `addressingMode`). protobufjs writes a
+   * field whenever the property EXISTS — `m.participant != null &&
+   * hasOwnProperty(m, 'participant')` (WAProto/index.js MessageKey.encode) — so
+   * `participant: ''` is NOT the same as absent: it goes out as an explicit empty
+   * participant, which is a group-shaped key attached to a 1:1 message.
+   *
+   * Symptom (Finart, 18/09/2026): reactions in group chats appear, reactions in
+   * 1:1 chats never do. Nothing errors — the stanza goes to the same devices as a
+   * text that delivers fine, and the API answers success.
+   */
+  private wireKey(key: WAMessage['key']): WAMessage['key'] {
+    const enxuta: WAMessage['key'] = { remoteJid: key.remoteJid, fromMe: key.fromMe, id: key.id };
+    if (key.participant) {
+      enxuta.participant = key.participant;
+    }
+    return enxuta;
+  }
