{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Iniciar tudo (OpenWA + WhatsApp + Teams + CIP + Email)",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "dependsOn": [
        "OpenWA",
        "Vigia WhatsApp",
        "Vigia Solida (Teams + CIP)",
        "Vigia Email"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "OpenWA",
      "detail": "Liga o OpenWA (API + painel). Deixe rodando.",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "iniciar-openwa.bat",
        "vscode"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "wpp",
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Vigia WhatsApp",
      "detail": "Baixa os documentos dos clientes para a pasta do dia.",
      "type": "process",
      "command": "python",
      "args": [
        "vigia_whatsapp.py",
        "--vigiar"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "wpp",
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Vigia Solida (Teams + CIP)",
      "detail": "Baixa o que a Solida manda, marca a mensagem e devolve os .ppf do CIP. Um processo so, porque os dois dividem a mesma janela de navegador.",
      "type": "process",
      "command": "python",
      "args": [
        "vigiar_teams_e_cip.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "wpp",
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Vigia Email",
      "detail": "Baixa os anexos do Gmail para a pasta do dia do cliente e marca o e-mail como lido.",
      "type": "process",
      "command": "python",
      "args": [
        "vigia_email.py",
        "--vigiar"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "wpp",
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "WhatsApp: testar (sem salvar nada)",
      "detail": "Mostra o que seria baixado agora, sem salvar.",
      "type": "process",
      "command": "python",
      "args": [
        "vigia_whatsapp.py",
        "--teste"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Abrir painel do OpenWA",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "start",
        "",
        "http://localhost:2886"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "label": "Teams: testar (sem salvar nada)",
      "detail": "Mostra o que seria baixado da conversa, sem salvar nem marcar.",
      "type": "process",
      "command": "python",
      "args": [
        "teams_web.py",
        "--teste"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Teams: refazer login",
      "detail": "Abre o navegador do robo para entrar de novo na conta pessoal (FINART CTP).",
      "type": "process",
      "command": "python",
      "args": [
        "teams_web.py",
        "--login"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "CIP: testar (sem enviar nada)",
      "type": "process",
      "command": "python",
      "args": [
        "vigia_cip.py",
        "--teste"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Email: testar (sem salvar nada)",
      "type": "process",
      "command": "python",
      "args": [
        "vigia_email.py",
        "--teste"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      }
    }
  ]
}
