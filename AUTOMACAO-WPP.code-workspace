{
  "folders": [
    {
      "path": ".",
      "name": "WPP"
    }
  ],
  "settings": {
    "files.encoding": "utf8",
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.tmp": true
    },
    "json.schemaDownload.enable": false
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "▶ Iniciar tudo (OpenWA + Vigia)",
        "runOptions": {
          "runOn": "folderOpen"
        },
        "dependsOn": [
          "OpenWA",
          "Vigia WhatsApp"
        ],
        "dependsOrder": "parallel",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "OpenWA",
        "detail": "Liga o OpenWA (API + painel). Deixe rodando.",
        "type": "process",
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "${workspaceFolder:WPP}\\iniciar-openwa.bat",
          "vscode"
        ],
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "group": "wpp",
          "panel": "dedicated",
          "reveal": "always",
          "clear": true
        }
      },
      {
        "label": "Vigia WhatsApp",
        "detail": "Baixa os documentos dos clientes para a pasta do dia.",
        "type": "process",
        "command": "python",
        "args": [
          "vigia_whatsapp.py",
          "--vigiar"
        ],
        "options": {
          "cwd": "${workspaceFolder:WPP}",
          "env": {
            "PYTHONIOENCODING": "utf-8"
          }
        },
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "group": "wpp",
          "panel": "dedicated",
          "reveal": "always",
          "clear": true
        }
      },
      {
        "label": "Vigia: testar (sem salvar nada)",
        "detail": "Mostra o que seria baixado agora, sem salvar.",
        "type": "process",
        "command": "python",
        "args": [
          "vigia_whatsapp.py",
          "--teste"
        ],
        "options": {
          "cwd": "${workspaceFolder:WPP}",
          "env": {
            "PYTHONIOENCODING": "utf-8"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "shared",
          "reveal": "always",
          "clear": true
        }
      },
      {
        "label": "Abrir painel do OpenWA",
        "type": "process",
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "start",
          "",
          "http://localhost:2886"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "never"
        }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python"
    ]
  }
}