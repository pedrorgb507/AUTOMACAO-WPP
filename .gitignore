# Cache do Python
__pycache__/
*.pyc

# Estado de execucao do vigia: muda a cada arquivo baixado.
# Versionar isso enche o historico de ruido e da conflito toda hora.
vigia.log
ja_baixados.json

# Segredos: senha de app do Gmail e token da Microsoft.
# Commitar isso vazaria a credencial no historico do git, onde ela fica
# para sempre mesmo se o arquivo for apagado depois.
config_email.json
token_cip.bin

# Estado e log dos outros vigias, mesmo motivo do vigia.log
vigia_cip.log
vigia_email.log
ja_baixados_email.json
pendencias_os.json

# Sessao logada do robo do Teams: contem cookies de login
perfil_teams_web/
teams_web.log
teams_web_tela.png

# Estado do robo do Teams Web, mesmo motivo do ja_baixados.json
ja_baixados_teams_web.json
diag_reacao/

# Configuracoes com dado de cliente (telefone, e-mail, ID de chat).
# O repositorio e publico: versionar isso publica o dado do cliente, e o
# historico do git guarda para sempre mesmo se o arquivo sair depois.
# Copias ficam em copias-de-seguranca/, que nao vai para o git.
config.json
config_cip.json
config_teams.json
copias-de-seguranca/

# O config do robo do Teams Web tambem nomeia cliente e grupo.
# Use o config_teams_web.EXEMPLO.json como molde.
config_teams_web.json

# Credenciais do Google Drive: o credenciais_drive.json identifica o aplicativo
# e o token_drive.json E o acesso a conta - quem tem o token le o Drive sem
# precisar de senha nenhuma.
credenciais_drive.json
token_drive.json

# Log do OpenWA: barulho de execucao, muda o tempo todo
openwa.log

# Perfil do Chrome do robo do Drive: sessao logada, nao pode ir para
# repositorio publico.
perfil_drive_web/

# Saidas de diagnostico geradas durante o trabalho com o Claude.
Claude outputs/
